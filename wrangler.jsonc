// Cloudflare Workers config: serves the built site in ./dist as static assets.
// No Worker script is needed for a static site.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listicles",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
